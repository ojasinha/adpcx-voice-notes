# Application
APP_NAME=Voice Notes API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# Audio and STT
MAX_AUDIO_MB=25
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SECONDS=60
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5

# LLM: any OpenAI-compatible POST /v1/chat/completions endpoint.
# Default is a local llama.cpp server started with:
#   llama-server -m <model.gguf> --host 127.0.0.1 --port 8080 --alias qwen3.5-4b
# LLM_API_KEY is ignored by llama.cpp unless it is started with --api-key.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local
LLM_MODEL=qwen3.5-4b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_MAX_ATTEMPTS=2

# Hosted example (bring your own key; do not commit it):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
