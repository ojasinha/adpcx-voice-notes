# Application
APP_NAME=Voice Notes API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# Audio and STT
MAX_AUDIO_MB=25
MAX_STREAM_SECONDS=120
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SECONDS=60
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5

# LLM: bring your own OpenAI-compatible POST /v1/chat/completions endpoint.
# LLM_BASE_URL and LLM_MODEL are required. LLM_API_KEY is required for hosted
# providers; leave it empty only for an unauthenticated local server.
# Use the API base URL without "/chat/completions"; the app appends it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_MAX_ATTEMPTS=2

# Examples (the model ID must be one your provider actually serves):
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1
#            LLM_MODEL=llama-3.3-70b-versatile
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1
#            LLM_MODEL=gpt-4o-mini
# llama.cpp: LLM_BASE_URL=http://127.0.0.1:8080/v1
#            LLM_MODEL=my-model
